---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 py-20 text-center">
    <h1 class="text-5xl font-bold leading-tight mb-6">
      Oilangizni<br/>
      <span class="text-indigo-600">Telegram'da</span> boshqaring
    </h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      Byudjet, yumushlar, eslatmalar, sog'liq va tug'ilgan kunlar — 
      hammasi bitta botda. O'zbek, Rus va Ingliz tillarida.
    </p>
    <div class="flex gap-4 justify-center">
      <a href="https://t.me/uyimiz_bot" 
         class="bg-indigo-600 text-white px-8 py-3 rounded-xl text-lg font-semibold hover:bg-indigo-700 transition-colors">
        🤖 Botni ishga tushirish
      </a>
      <a href="/uz/features" 
         class="border border-gray-300 px-8 py-3 rounded-xl text-lg font-semibold hover:bg-gray-50 transition-colors">
        Batafsil →
      </a>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Nimalar qila oladi?</h2>
      <div class="grid grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-semibold text-lg mb-2">Byudjet boshqaruvi</h3>
          <p class="text-gray-600 text-sm">Xarajat va daromadlarni kuzating. Kategoriyalar bo'yicha hisobot oling.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-semibold text-lg mb-2">Yumushlar ro'yxati</h3>
          <p class="text-gray-600 text-sm">Vazifalarni oila a'zolariga taqsimlang. Ballar to'plang!</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">🔔</div>
          <h3 class="font-semibold text-lg mb-2">Avtomatik eslatmalar</h3>
          <p class="text-gray-600 text-sm">Tug'ilgan kunlar, dori va muhim sanalar hech qachon unutilmaydi.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">👶</div>
          <h3 class="font-semibold text-lg mb-2">Farzand tarbiyasi</h3>
          <p class="text-gray-600 text-sm">Bolalar rivojlanishi, emlash kalendari, jadval — hammasi bir joyda.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">🏃</div>
          <h3 class="font-semibold text-lg mb-2">Sog'liq kuzatuvi</h3>
          <p class="text-gray-600 text-sm">BMI, bosim, uyqu va suv iste'moli — sog'lom turmush tarzi uchun.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">💊</div>
          <h3 class="font-semibold text-lg mb-2">Dori va birinchi yordam</h3>
          <p class="text-gray-600 text-sm">Dori jadvali, qidiruv va birinchi yordam bo'yicha bilimlar bazasi.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <h2 class="text-3xl font-bold mb-4">Boshlash uchun tayyormisiz?</h2>
    <p class="text-gray-600 mb-8">Telegram'da @uyimiz_bot ga o'ting va oilangizni boshqarishni bugunoq boshlang.</p>
    <a href="https://t.me/uyimiz_bot" 
       class="inline-block bg-indigo-600 text-white px-10 py-4 rounded-xl text-xl font-semibold hover:bg-indigo-700 transition-colors">
      🤖 @uyimiz_bot
    </a>
  </section>
</Layout>
