---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="@uyimiz — Oilangizni Telegram'da boshqaring" lang="uz">
  <section class="hero">
    <h1>Oilangizni<br/>Telegram'da boshqaring</h1>
    <p>Byudjet, yumushlar, eslatmalar, tug'ilgan kunlar — hammasi bitta botda. Premium dizayn, 3 tilda.</p>
    <div class="button-row">
      <a href="https://t.me/uyimiz_bot" class="button primary">🤖 Botni ishga tushirish</a>
      <a href="/uz/features" class="button secondary">Batafsil →</a>
    </div>
  </section>

  <section class="feature-grid">
    <div class="feature-card">
      <span class="icon">💰</span>
      <h3>Byudjet boshqaruvi</h3>
      <p>Daromad va xarajatlarni kuzating. Kategoriyalar bo'yicha hisobot oling. Keypad orqali tez kiritish.</p>
    </div>
    <div class="feature-card">
      <span class="icon">📋</span>
      <h3>Yumushlar ro'yxati</h3>
      <p>Vazifalarni oila a'zolariga taqsimlang. Check-circle orqali bajarilganini belgilang. Ballar to'plang.</p>
    </div>
    <div class="feature-card">
      <span class="icon">🔔</span>
      <h3>Avtomatik eslatmalar</h3>
      <p>Tug'ilgan kunlar, dorilar va muhim sanalar hech qachon unutilmaydi. Telegram orqali bildirishnoma.</p>
    </div>
  </section>
</Layout>
