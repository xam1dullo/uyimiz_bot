---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <section class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-bold mb-6">Narxlar</h1>
    
    <div class="grid grid-cols-2 gap-8 mt-12 max-w-2xl mx-auto">
      <!-- Free -->
      <div class="border rounded-2xl p-8">
        <h2 class="text-xl font-bold mb-2">Bepul</h2>
        <p class="text-4xl font-bold mb-4">0 UZS</p>
        <ul class="text-sm text-gray-600 space-y-2 mb-6">
          <li>✅ 4 tagacha oila a'zosi</li>
          <li>✅ Asosiy byudjet</li>
          <li>✅ Yumushlar + ballar</li>
          <li>✅ 30 eslatma/oy</li>
          <li>✅ Tug'ilgan kunlar</li>
        </ul>
        <a href="https://t.me/uyimiz_bot" class="block border border-indigo-600 text-indigo-600 py-2 rounded-lg font-medium hover:bg-indigo-50 transition-colors">Boshlash</a>
      </div>

      <!-- Premium -->
      <div class="border-2 border-indigo-600 rounded-2xl p-8 relative">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-xs px-3 py-1 rounded-full">Tez kunda</span>
        <h2 class="text-xl font-bold mb-2">Premium</h2>
        <p class="text-4xl font-bold mb-4">29,000 <span class="text-lg text-gray-500">UZS/oy</span></p>
        <ul class="text-sm text-gray-600 space-y-2 mb-6">
          <li>✅ Cheksiz a'zolar</li>
          <li>✅ Kengaytirilgan statistika</li>
          <li>✅ Cheksiz eslatmalar</li>
          <li>✅ AI maslahatchi</li>
          <li>✅ PDF hisobotlar</li>
          <li>✅ Prioritet support</li>
        </ul>
        <a href="#" class="block bg-indigo-600 text-white py-2 rounded-lg font-medium text-center">Tez kunda</a>
      </div>
    </div>
  </section>
</Layout>
