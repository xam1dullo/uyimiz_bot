---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Imkoniyatlar</h1>
    
    <div class="space-y-12">
      <div class="flex gap-6">
        <div class="text-4xl">💰</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Byudjet boshqaruvi</h2>
          <p class="text-gray-600">Daromad va xarajatlarni qo'shing. 8 ta kategoriya bo'yicha hisobot. Oylik, haftalik va kunlik statistika. Byudjet limiti belgilang — oshganda bot ogohlantiradi.</p>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="text-4xl">📋</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Yumushlar + Gamification</h2>
          <p class="text-gray-600">Vazifalarni oila a'zolariga taqsimlang. Har bajarilgan vazifa uchun 10-50 ball. Haftalik liderboard. "Oila Qahramoni" unvoni!</p>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="text-4xl">🎂</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Tug'ilgan kun eslatmalari</h2>
          <p class="text-gray-600">Oila va yaqinlaringizning tug'ilgan kunlari 7, 3 va 1 kun oldin avtomatik eslatiladi. 29 fevral tug'ilganlar uchun leap year support.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
