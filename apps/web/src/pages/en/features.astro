---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Features</h1>
    <div class="space-y-12">
      <div class="flex gap-6">
        <div class="text-4xl">💰</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Budget Management</h2>
          <p class="text-gray-600">Add income and expenses. Reports across 8 categories. Monthly, weekly, and daily statistics. Set a budget limit — the bot warns when exceeded.</p>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="text-4xl">📋</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Tasks & Gamification</h2>
          <p class="text-gray-600">Assign tasks to family members. 10-50 points per completed task. Weekly leaderboard. "Family Hero" title!</p>
        </div>
      </div>
      <div class="flex gap-6">
        <div class="text-4xl">🎂</div>
        <div>
          <h2 class="text-2xl font-bold mb-2">Birthday Reminders</h2>
          <p class="text-gray-600">Automatic reminders 7, 3, and 1 day before birthdays. Leap year support (February 29th).</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
