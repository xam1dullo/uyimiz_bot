---
import Layout from '../../layouts/Layout.astro';
---
<Layout>
  <section class="max-w-6xl mx-auto px-4 py-20 text-center">
    <h1 class="text-5xl font-bold leading-tight mb-6">
      Manage your family<br/>
      <span class="text-indigo-600">on Telegram</span>
    </h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      Budget, tasks, reminders, health & birthdays —
      all in one bot. In Uzbek, Russian & English.
    </p>
    <div class="flex gap-4 justify-center">
      <a href="https://t.me/uyimiz_bot" 
         class="bg-indigo-600 text-white px-8 py-3 rounded-xl text-lg font-semibold hover:bg-indigo-700 transition-colors">
        🤖 Launch Bot
      </a>
      <a href="/en/features" 
         class="border border-gray-300 px-8 py-3 rounded-xl text-lg font-semibold hover:bg-gray-50 transition-colors">
        Learn More →
      </a>
    </div>
  </section>

  <section class="bg-gray-50 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Features</h2>
      <div class="grid grid-cols-3 gap-8">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-semibold text-lg mb-2">Budget Management</h3>
          <p class="text-gray-600 text-sm">Track expenses & income. Get reports by category.</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-semibold text-lg mb-2">Task List</h3>
          <p class="text-gray-600 text-sm">Assign tasks to family members. Earn points!</p>
        </div>
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <div class="text-3xl mb-3">🔔</div>
          <h3 class="font-semibold text-lg mb-2">Auto Reminders</h3>
          <p class="text-gray-600 text-sm">Birthdays, medications & important dates — never forgotten.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-20 text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to start?</h2>
    <p class="text-gray-600 mb-8">Go to @uyimiz_bot on Telegram and start managing your family today.</p>
    <a href="https://t.me/uyimiz_bot" 
       class="inline-block bg-indigo-600 text-white px-10 py-4 rounded-xl text-xl font-semibold hover:bg-indigo-700 transition-colors">
      🤖 @uyimiz_bot
    </a>
  </section>
</Layout>
