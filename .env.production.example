# Production environment template
# Copy to .env.production and fill in real values

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://t.me

# Database
POSTGRES_USER=uyimiz
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=uyimiz
DATABASE_URL=postgres://uyimiz:<password>@postgres:5432/uyimiz

# Redis (with password in production)
REDIS_PASSWORD=<generate-strong-password>
REDIS_URL=redis://:<password>@redis:6379

# Telegram Bot
BOT_TOKEN=<from-botfather>
BOT_WEBHOOK_DOMAIN=bot.yourdomain.com
BOT_WEBHOOK_PATH=/bot/webhook

# JWT (min 32 chars)
JWT_SECRET=<generate-64-char-random-string>

# Mini App
MINIAPP_URL=https://miniapp.yourdomain.com

# Optional
SENTRY_DSN=
OPENAI_API_KEY=
WEATHER_API_KEY=

# Database — Production: use non-superuser role for RLS enforcement
# POSTGRES_USER=uyimiz_app
# POSTGRES_PASSWORD=change-me-in-production
